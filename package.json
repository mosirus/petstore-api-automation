{
  "name": "petstore-api-automation",
  "version": "2.0.0",
  "private": true,
  "description": "API automation tests for the Swagger Petstore (POST /pet, GET /pet/findByStatus, DELETE /pet/{petId}) using Playwright Test.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:known-issues": "playwright test --grep @known-issue",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.1"
  }
}
